# Copy this file to .env to change settings. Never share or upload .env.

# Language model used by the checks and the answers: ollama (free, local) or claude
AI_BACKEND=ollama
OLLAMA_MODEL=llama3.1:8b

# Only needed for AI_BACKEND=claude or src/claude_answer.py
